# Base URL for API calls. Keep it as /api in both development and production:
#  - development: Vite forwards /api (and /socket.io) to the backend (see vite.config.js; VITE_API_PROXY changes the target)
#  - production: vercel.json forwards /api to the backend, so the login cookie stays on this site
VITE_API_BASE_URL=/api

# Live updates (Socket.IO) connect straight to the backend in production (Vercel can't forward WebSockets).
# Leave empty in development.
# VITE_SOCKET_URL=https://mindcarve-backend.onrender.com
